# Copie este archivo como ".env" y llene los valores. NUNCA lo suba a GitHub ni lo comparta.

# --- Meta / Instagram ---
IG_VERIFY_TOKEN=invente-una-frase-larga-y-unica
IG_APP_SECRET=secreto-de-la-app-de-meta
IG_ACCESS_TOKEN=token-de-acceso-de-instagram
# ID numérico de la cuenta @miecolavado (aparece en Meta, junto al nombre de la cuenta)
IG_ACCOUNT_ID=
IG_GRAPH_VERSION=v23.0
# Con token que empieza por EAA (Unified Login) deje esta línea tal cual:
IG_API_BASE=https://graph.facebook.com

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-5-5

# --- Sistema de la lavandería (solo lectura) ---
SISTEMA_URL=https://64-177-50-255.sslip.io
BOT_TOKEN=bot_...

# --- Aviso al personal (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ajustes ---
PORT=8081
MAX_MSGS_DIA=20
HANDOFF_HORAS=12
# 1 = el bot da el precio BASE de dry clean (aclarando que se valora en persona); 0 = no da ningún precio
DRYCLEAN_PRECIO_BASE=1
# 0 = apaga el bot sin detener el servidor
BOT_ACTIVO=1

# --- Panel web ---
# Contraseña para entrar al panel (mínimo 8 caracteres). Se pone con el script, no a mano.
PANEL_PASSWORD=
PANEL_PORT=8082
# Días que se guardan las conversaciones para el panel (el bot solo usa 3 días como contexto)
LOG_DIAS=60
