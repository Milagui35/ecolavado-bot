[Unit]
Description=Bot de Instagram - Mi Eco Lavado
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/ecolavado-bot
ExecStart=/usr/bin/python3 /opt/ecolavado-bot/bot.py
Restart=always
RestartSec=5
User=ecobot
# El archivo .env vive en WorkingDirectory y solo debe poder leerlo el usuario ecobot (chmod 600)

[Install]
WantedBy=multi-user.target
